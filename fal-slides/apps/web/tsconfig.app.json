{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@fal-slides/brand": ["../../packages/brand/tokens.ts"],
      "@fal-slides/brand/*": ["../../packages/brand/*"],
      "@fal-slides/dust-engine": ["../../packages/dust-engine/src/index.ts"],
      "@brand/*": ["../../packages/brand/*"]
    }
  },
  "include": ["src", "../../packages/dust-engine/src", "../../packages/brand/tokens.ts"]
}
